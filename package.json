{
  "name": "weave-js",
  "workspaces": [
    "misc/development/cli/simple",
    "packages/cache/*",
    "packages/core/*",
    "packages/transports/*",
    "packages/tracing-adapters/*",
    "packages/services/*",
    "packages/lock-stores/*",
    "packages/lock-stores/lock-store-adapters/*"
  ],
  "scripts": {
    "test": "jest",
    "audit": "npm audit fix",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.mts,.tsx --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "npm exec --workspaces -- npx rimraf node_modules && npx rimraf node_modules",
    "align-versions": "syncpack",
    "align-semver": "syncpack set-semver-ranges --types dev,prod --semver-range ^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weave-microservices/weave.git"
  },
  "keywords": [
    "micro",
    "service",
    "microservice",
    "micro-service",
    "microservices",
    "micro-services",
    "service-mesh",
    "services",
    "micro services",
    "micro service",
    "framework",
    "viable",
    "minimum",
    "product",
    "startup",
    "toolkit",
    "redis",
    "nats",
    "tcp",
    "pubsub",
    "messaging",
    "subscribe",
    "ddd",
    "queue",
    "distributed",
    "publish",
    "queue",
    "message-queue",
    "cqrs"
  ],
  "author": {
    "name": "Kevin Ries",
    "company": "Fachwerk Software",
    "email": "kevin.ries@fachwerk.io",
    "url": "https://fachwerk.io"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/weave-microservices/weave/issues"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@sinonjs/fake-timers": "^11.1.0",
    "@types/jest": "^29.5.5",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "concurrently": "^8.2.1",
    "eslint": "^9.39.1",
    "eslint-config-fw": "^1.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "syncpack": "^13.0.4",
    "workspace-version": "^0.1.4"
  }
}
